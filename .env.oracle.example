# Copy to .env.oracle on the Oracle VM. Do not commit .env.oracle.
NEXUS_DOMAIN=nexus.example.com
POSTGRES_DB=multiplayer_ai
POSTGRES_USER=nexus
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Keep the existing Render value when importing its database.
INTEGRATION_ENCRYPTION_KEY=replace-with-your-existing-key
AGENT_LLM_BASE_URL=https://provider.example.com/v1
AGENT_LLM_API_KEY=replace-with-provider-key
AGENT_LLM_MODEL=provider-model
AGENT_LLM_MAX_TOKENS=1024
AGENT_LLM_TPM_LIMIT=8192
# Optional paid primary. When this account reports exhausted credit or quota,
# Nexus automatically falls back to the AGENT_LLM_* provider above.
AGENT_LLM_PRIMARY_BASE_URL=https://api.openai.com/v1
AGENT_LLM_PRIMARY_API_KEY=
AGENT_LLM_PRIMARY_MODEL=gpt-6-luna
AGENT_LLM_PRIMARY_MAX_TOKENS=1024
AGENT_LLM_PRIMARY_TPM_LIMIT=8192
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
FIGMA_OAUTH_CLIENT_ID=
FIGMA_OAUTH_CLIENT_SECRET=
FIGMA_MCP_URL=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
# Gmail: set GMAIL_SMTP_USER plus either an App Password (SMTP) or all three
# GMAIL_API_* values. Without one of these (or RESEND_API_KEY), invitations fail.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
GMAIL_API_CLIENT_ID=
GMAIL_API_CLIENT_SECRET=
GMAIL_API_REFRESH_TOKEN=
