# Copy to .env.oracle on the Oracle VM. Do not commit .env.oracle.
NEXUS_DOMAIN=nexus.example.com
POSTGRES_DB=multiplayer_ai
POSTGRES_USER=nexus
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Keep the existing Render value when importing its database.
INTEGRATION_ENCRYPTION_KEY=replace-with-your-existing-key
AGENT_LLM_BASE_URL=https://provider.example.com/v1
AGENT_LLM_API_KEY=replace-with-provider-key
AGENT_LLM_MODEL=provider-model
AGENT_LLM_MAX_TOKENS=1024
AGENT_LLM_TPM_LIMIT=8192
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
FIGMA_OAUTH_CLIENT_ID=
FIGMA_OAUTH_CLIENT_SECRET=
FIGMA_MCP_URL=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
MAILER_MODE=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
